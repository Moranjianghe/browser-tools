# Shared browser settings
# Optional: leave CHROME_PATH empty if Chrome/Edge is installed in a standard Windows location.
# CHROME_PATH=
# Optional: leave BROWSER_PROFILE_DIR empty to use ./profiles/shared under this folder.
# BROWSER_PROFILE_DIR=
REMOTE_DEBUGGING_PORT=9223

# If you start Chrome in debug mode and want browser-use to attach to it,
# uncomment this line.
# BROWSER_CDP_URL=http://127.0.0.1:9223

# LLM selection for browser-use
# Recommended default: use an OpenAI/Codex-compatible endpoint.
BROWSER_USE_LLM=openai
BROWSER_USE_MODEL=gpt-5.3-codex
BROWSER_USE_REASONING_EFFORT=high
OPENAI_WIRE_API=responses
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_CODEX_COMPAT=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://www.openclaudecode.cn/v1

# Optional overrides for Codex-compatible gateways.
# OPENAI_CODEX_ORIGINATOR=codex_cli_rs
# OPENAI_CODEX_USER_AGENT=
# OPENAI_CODEX_INSTALLATION_ID=
# OPENAI_CODEX_WINDOW_ID=
# OPENAI_CODEX_CONVERSATION_ID=

# Alternative: use LiteLLM explicitly.
# BROWSER_USE_LLM=litellm
# BROWSER_USE_MODEL=openai/gpt-4.1-mini

# Alternative: use browser-use's own hosted model instead.
# BROWSER_USE_LLM=browser-use
# BROWSER_USE_MODEL=bu-latest
# BROWSER_USE_API_KEY=
# BROWSER_USE_API_BASE=
